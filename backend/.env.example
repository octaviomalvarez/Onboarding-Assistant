# Copiá este archivo como .env y completá los valores
# NUNCA subas .env al repositorio

# --- Proveedor de LLM ---
# Opciones: "lmstudio" (local, gratis) | "anthropic" (producción)
LLM_PROVIDER=lmstudio

# --- LM Studio (desarrollo local) ---
# Abrí LM Studio, cargá un modelo y activá el servidor local
# El puerto por defecto es 1234
LMSTUDIO_URL=http://localhost:1234/v1

# --- Anthropic Claude (producción) ---
# Solo necesario si LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# --- Servidor ---
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000
